<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Profile | Instogram</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="icon" type="image/jpeg" href="/instogram.jpg" />
  </head>
  <body>
    <header class="py-2">
      <%- include('./partials/navbar.ejs', {
        activePage: 'profile',
        showAddPost: true,
        userId: data.UserId,
        searchAction: '/',
        searchPlaceholder: 'Search by caption',
      }) %>
    </header>
    <main class="container py-4">
      <% const displayName =
        data.fullName || [data.firstName, data.lastName].filter(Boolean).join(' ') || 'friend'; %>
      <section class="hero-card mb-5">
        <div class="row align-items-center gy-4">
          <div class="col-lg-8">
            <h1 class="hero-title mb-2">Hey, <%= displayName %> 👋</h1>
            <p class="hero-text mb-3">
              You have shared
              <strong><%= data.Posts.length %></strong> unforgettable moment<%=
              data.Posts.length === 1 ? '' : 's' %>. Keep your gallery thriving
              by adding fresh takes.
            </p>
            <div class="d-flex flex-wrap gap-3">
              <a
                class="btn btn-primary btn-pill"
                href="/profile/<%= data.UserId %>/addpost"
              >
                <i class="bi bi-plus-circle me-2"></i>Create new post
              </a>
              <a
                class="btn btn-outline-primary btn-pill"
                href="/profile/<%= data.UserId %>/edit"
              >
                <i class="bi bi-pencil-square me-2"></i>Edit profile
              </a>
            </div>
          </div>
          <div class="col-lg-4 text-lg-end">
            <div class="badge-soft">Updated moments in real time</div>
          </div>
        </div>
      </section>

      <section class="mb-5">
        <h2 class="section-title">Your posts</h2>
        <% if (data.Posts.length === 0) { %>
        <div class="alert alert-info alert-custom" role="alert">
          <i class="bi bi-camera me-2"></i>You have not posted anything yet.
          Share your first story!
        </div>
        <% } else { %>
        <div class="feed-grid">
        <% data.Posts.forEach((post) => {
             const liked = likedPosts && likedPosts[post.id];
        %>
          <article class="post-card">
            <div class="post-card-media">
              <img src="<%= post.imageUrl %>" alt="Post image" />
            </div>
            <div class="card-body">
              <div
                class="d-flex justify-content-between align-items-center mb-2"
              >
                <span class="badge-soft" data-like-count-id="<%= post.id %>"
                  ><i class="bi bi-heart-fill me-1"></i
                  ><span data-like-count><%= post.totalLike %></span>
                  likes</span
                >
                <small class="muted-text"><%= getTime(post.createdAt) %></small>
              </div>
              <p class="mb-3"><%= post.caption %></p>
              <div class="d-flex flex-wrap gap-2">
                <a
                  class="btn btn-outline-primary btn-pill"
                  href="/profile/<%= post.id %>/comment"
                >
                  <i class="bi bi-chat-dots me-1"></i>Comments
                </a>
                <button
                  type="button"
                  class="btn btn-pill like-btn <%= liked ? 'btn-success text-white' : 'btn-outline-success' %>"
                  data-like-button="true"
                  data-post-id="<%= post.id %>"
                  data-liked="<%= liked ? 'true' : 'false' %>"
                >
                  <i class="bi bi-hand-thumbs-up me-1"></i>
                  <span><%= liked ? 'Liked' : 'Like' %></span>
                </button>
                <a
                  class="btn btn-outline-danger btn-pill"
                  href="/profile/<%= post.id %>/delete"
                  onclick="return confirm('Delete this post?');"
                >
                  <i class="bi bi-trash me-1"></i>Delete
                </a>
              </div>
            </div>
          </article>
        <% }); %>
        </div>
        <% } %>
      </section>
    </main>
    <footer class="footer-space">Keep sharing the good vibes ✨</footer>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="/js/main.js"></script>
  </body>
</html>
