<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Explore | Instogram</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="icon" type="image/jpeg" href="/instogram.jpg" />
  </head>
  <body>
    <header class="py-2">
      <% const navbarConfig = {
        activePage: 'explore',
        searchAction: '/',
        searchPlaceholder: 'Search the community',
        searchValue: typeof search !== 'undefined' ? search : '',
      }; %>
      <%- include('./partials/navbar.ejs', navbarConfig) %>
    </header>
    <main class="container py-4">
      <section class="hero-card mb-5">
        <div class="row align-items-center gy-3">
          <div class="col-lg-8">
            <h1 class="hero-title mb-2">Discover the latest highlights</h1>
            <p class="hero-text mb-0">
              Browse trending snaps from the community. Tap like to spread the
              love or jump into the conversation.
            </p>
          </div>
          <div class="col-lg-4 text-lg-end">
            <span class="badge-soft"
              ><i class="bi bi-lightning me-2"></i>Fresh content every
              minute</span
            >
          </div>
        </div>
      </section>

      <% if (!data.length) { %>
      <div class="alert alert-info alert-custom" role="alert">
        <i class="bi bi-emoji-smile me-2"></i>No posts yet. Be the first to
        upload something awesome!
      </div>
      <% } else { %>
      <div class="feed-grid">
        <% data.forEach((post) => { %>
        <% const liked = likedPosts && likedPosts[post.id]; %>
        <article class="post-card">
          <div class="post-card-media">
            <img src="<%= post.imageUrl %>" alt="Post image" />
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge-soft" data-like-count-id="<%= post.id %>"
                ><i class="bi bi-heart-fill me-1"></i
                ><span data-like-count><%= post.totalLike %></span> likes</span
              >
              <small class="muted-text"><%= getTime(post.createdAt) %></small>
            </div>
            <p class="mb-3"><%= post.caption %></p>
            <div class="d-flex gap-2 flex-wrap">
              <a
                class="btn btn-outline-primary btn-pill"
                href="/comment/<%= post.id %>"
              >
                <i class="bi bi-chat-left-dots me-1"></i>Comments
              </a>
              <button
                type="button"
                class="btn btn-pill like-btn <%= liked ? 'btn-success text-white' : 'btn-outline-success' %>"
                data-like-button="true"
                data-post-id="<%= post.id %>"
                data-liked="<%= liked ? 'true' : 'false' %>"
              >
                <i class="bi bi-hand-thumbs-up me-1"></i>
                <span><%= liked ? 'Liked' : 'Like' %></span>
              </button>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>
    </main>
    <footer class="footer-space">Keep exploring and stay inspired 🌟</footer>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="/js/main.js"></script>
  </body>
</html>
