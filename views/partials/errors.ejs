<% if (errors) { %> <% const messageSource = Array.isArray(errors) ? errors :
typeof errors === 'string' ? errors.split(',') : []; %> <% if
(messageSource.length) { %>
<div class="alert alert-danger alert-custom text-start" role="alert">
  <ul class="mb-0 ps-3">
    <% messageSource.forEach((msg) => { %>
    <li><%= msg %></li>
    <% }) %>
  </ul>
</div>
<% } %> <% } %>
