<% const computedActive = typeof activePage === 'string' ? activePage : ''; %>
<% const enableSearch = typeof searchAction !== 'undefined'; %>
<% const enableAddPost = Boolean(typeof showAddPost !== 'undefined' && showAddPost && userId); %>

<div class="container px-3 px-lg-0">
  <nav class="navbar navbar-expand-lg navbar-light navbar-custom">
    <div class="container-fluid px-0">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/instogram.jpg" alt="Instogram" class="navbar-logo" />
        <span>Instogram</span>
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a
              class="nav-link <%= computedActive === 'explore' ? 'active' : '' %>"
              href="/"
              >Explore</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link <%= computedActive === 'profile' ? 'active' : '' %>"
              href="/profile"
              >My Profile</a
            >
          </li>
          <% if (enableAddPost) { %>
          <li class="nav-item">
            <a
              class="nav-link <%= computedActive === 'add-post' ? 'active' : '' %>"
              href="/profile/<%= userId %>/addpost"
              >New Post</a
            >
          </li>
          <% } %>
        </ul>
        <% if (enableSearch) { %>
        <form
          action="<%= searchAction %>"
          class="d-flex me-lg-3 mb-3 mb-lg-0"
          role="search"
        >
          <input
            class="form-control me-2"
            type="text"
            name="search"
            value="<%= typeof searchValue !== 'undefined' ? searchValue : '' %>"
            placeholder="<%= searchPlaceholder || 'Search posts' %>"
            aria-label="Search"
          />
          <button class="btn btn-outline-primary btn-pill" type="submit">
            Search
          </button>
        </form>
        <% } %>
        <a class="btn btn-outline-danger btn-pill" href="/logout">Logout</a>
      </div>
    </div>
  </nav>
</div>
